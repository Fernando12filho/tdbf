# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Project runtime output
runs/
logs/

# Harness summary JSONs (run_harness moves them to logs/harness_reports/; this is a safety net)
*.json
# the frozen samples and their environment records define the experiment's N:
# keep them versioned (untracked from 902cc61 to 2026-11-03)
!sample_*_frozen.json
!sample_*_env.json

# Secrets
.env

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Claude Code local state
.claude/

# Webapp generated SQLite (rebuilt from results.jsonl via `flask sync`)
webapp/tdbf.db

# HuggingFace dataset cache
~/.cache/huggingface/
figures/
docs/

# Local experiment logs / scratch
scratchpad/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.lof
*.lot
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
thesis/main.pdf
thesisproposal/main.pdf
thesis/main.log
thesisproposal/main.log

# The frozen RQ1 sample must be versioned: its commit is the pre-registration record.

# Not published: paper sources, notes, sample/env records
thesis/
thesisproposal/
*.md
!README.md

# Study folders are versioned in full: the committed and tagged protocol is the
# pre-registration record, like the frozen samples above.
!studies/**/*.md
!studies/**/*.json

# Third-party datasets the user downloads by hand; never committed. Data derived
# from them goes in the study folder, with the source's licence and attribution.
external/
